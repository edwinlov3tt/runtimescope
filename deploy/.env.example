# Production deployment environment variables
# Copy to .env and fill in values. Never commit .env.

# REQUIRED: Random secret used to authenticate SDK connections.
# Generate with: openssl rand -hex 32
AUTH_TOKEN=

# Your public domain (for reference — also update deploy/Caddyfile)
# DOMAIN=runtimescope.yourcompany.com

# Optional overrides (defaults shown)
# RUNTIMESCOPE_BUFFER_SIZE=10000
# RETENTION_DAYS=30          # bump (e.g. 400) if you use 12-month analytics windows

# --- Analytics (ADR-0012/0014) ---
# Admin de-anon secret (slice 6): enables the PII reveal path
# (/api/analytics/admin/*, X-Admin-Key gated + audited). Empty ⇒ closed.
# Generate with: openssl rand -hex 32
# ADMIN_KEY=
# Let the uptime probe reach private/loopback IPs (default-deny — SSRF). 1 only on
# a trusted private network.
# UPTIME_ALLOW_PRIVATE=
